{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Expressive",
	"settings": {
		"custom": {
			"letterSpacing": {
				"display": "-0.025em",
				"large": "-0.025em",
				"medium": "-0.025em",
				"base": "-0.025em"
			}
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#D040E0"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "base-2",
					"name": "Base 2",
					"color": "#F9FAFB"
				},
				{
					"slug": "base-3",
					"name": "Base 3",
					"color": "#F3F4F6"
				},
				{
					"slug": "base-4",
					"name": "Base 4",
					"color": "#E5E7EB"
				},
				{
					"slug": "base-5",
					"name": "Base 5",
					"color": "#D1D5DB"
				},
				{
					"slug": "base-6",
					"name": "Base 6",
					"color": "#9CA3AF"
				},
				{
					"slug": "base-7",
					"name": "Base 7",
					"color": "#B4B6BA"
				},
				{
					"slug": "contrast-5",
					"name": "Contrast 5",
					"color": "#828B98"
				},
				{
					"slug": "contrast-4",
					"name": "Contrast 4",
					"color": "#6B7280"
				},
				{
					"slug": "contrast-3",
					"name": "Contrast 3",
					"color": "#4B5563"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast 2",
					"color": "#374151"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#030712"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans'",
					"fontFace": [
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-italic.woff2"
							],
							"fontDisplay": "swap"
						}
					]
				},
				{
					"fontFamily": "'Space Grotesk', sans-serif",
					"name": "Space Grotesk",
					"slug": "space-grotesk",
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "'Space Grotesk'",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": [
								"file:./assets/fonts/space-grotesk/SpaceGrotesk-Variable.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display-2-xl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display-xl)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--extra-large)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			}
		}
	}
}
