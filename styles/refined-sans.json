{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Refined Sans",
	"settings": {
		"custom": {
			"letterSpacing": {
				"display": "-0.015em",
				"large": "-0.015em",
				"medium": "-0.015em",
				"base": "-0.015em"
			}
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#E8368C"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "base-2",
					"name": "Base 2",
					"color": "#F8FAFC"
				},
				{
					"slug": "base-3",
					"name": "Base 3",
					"color": "#F1F5F9"
				},
				{
					"slug": "base-4",
					"name": "Base 4",
					"color": "#E2E8F0"
				},
				{
					"slug": "base-5",
					"name": "Base 5",
					"color": "#E2E8F0"
				},
				{
					"slug": "base-6",
					"name": "Base 6",
					"color": "#CBD5E1"
				},
				{
					"slug": "base-7",
					"name": "Base 7",
					"color": "#B7BAC1"
				},
				{
					"slug": "contrast-5",
					"name": "Contrast 5",
					"color": "#828B98"
				},
				{
					"slug": "contrast-4",
					"name": "Contrast 4",
					"color": "#6B7280"
				},
				{
					"slug": "contrast-3",
					"name": "Contrast 3",
					"color": "#475569"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast 2",
					"color": "#334155"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#0F172A"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans'",
					"fontFace": [
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-italic.woff2"
							],
							"fontDisplay": "swap"
						}
					]
				},
				{
					"fontFamily": "DM Sans, sans-serif",
					"name": "DM Sans",
					"slug": "dm-sans",
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"src": [
								"file:./assets/fonts/dm-sans/DMSans-VariableFont_opsz,wght.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--dm-sans)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--dm-sans)",
					"lineHeight": "1.2"
				}
			}
		}
	}
}
