{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Editorial",
	"settings": {
		"custom": {
			"letterSpacing": {
				"display": "-0.02em",
				"large": "-0.02em",
				"medium": "-0.02em",
				"base": "-0.02em"
			}
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#E8456B"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#FAFAF8"
				},
				{
					"slug": "base-2",
					"name": "Base 2",
					"color": "#F5F3EF"
				},
				{
					"slug": "base-3",
					"name": "Base 3",
					"color": "#EFEDE8"
				},
				{
					"slug": "base-4",
					"name": "Base 4",
					"color": "#E8E5DF"
				},
				{
					"slug": "base-5",
					"name": "Base 5",
					"color": "#E7E5E4"
				},
				{
					"slug": "base-6",
					"name": "Base 6",
					"color": "#D6D3D1"
				},
				{
					"slug": "base-7",
					"name": "Base 7",
					"color": "#B8B6B3"
				},
				{
					"slug": "contrast-5",
					"name": "Contrast 5",
					"color": "#828B98"
				},
				{
					"slug": "contrast-4",
					"name": "Contrast 4",
					"color": "#6B7280"
				},
				{
					"slug": "contrast-3",
					"name": "Contrast 3",
					"color": "#57534E"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast 2",
					"color": "#44403C"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#1C1917"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans'",
					"fontFace": [
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/inter-400-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/inter/inter-500-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter/inter-600-italic.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-normal.woff2"
							],
							"fontDisplay": "swap"
						},
						{
							"fontFamily": "\"Inter\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/inter/inter-700-italic.woff2"
							],
							"fontDisplay": "swap"
						}
					]
				},
				{
					"fontFamily": "'Source Serif 4', Georgia, 'Times New Roman', serif",
					"name": "Source Serif 4",
					"slug": "source-serif",
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "'Source Serif 4'",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/source-serif/SourceSerif4-700.woff2"
							]
						},
						{
							"fontDisplay": "swap",
							"fontFamily": "'Source Serif 4'",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/source-serif/SourceSerif4-600.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"lineHeight": "1.2"
				}
			}
		}
	}
}
